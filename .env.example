# Client-side Google Maps key
# Only needed if MyFixly displays Google Maps.
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# MyFixly frontend/public URL
VITE_APP_URL=http://10.246.151.218:8080

# Server-side only.
# NEVER prefix with VITE.
# NEVER expose this key in the frontend or Android app.
GOOGLE_MAPS_ROUTES_API_KEY=YOUR_GOOGLE_MAPS_ROUTES_API_KEY_HERE